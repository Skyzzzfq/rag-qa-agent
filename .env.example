# ===== LLM 配置 =====
# Chat 模型的 API Key（用户自行配置）
LLM_API_KEY=
# Chat 模型的 API Base URL（用户自行配置，支持 OpenAI 兼容接口）
LLM_API_BASE=
# Chat 模型名称（用户自行配置，如 gpt-4o、deepseek-chat 等）
LLM_MODEL_NAME=

# ===== Embedding 配置 =====
# Embedding 模型的 API Key（可与 LLM_API_KEY 相同，用户自行配置）
EMBEDDING_API_KEY=
# Embedding 模型的 API Base URL（用户自行配置）
EMBEDDING_API_BASE=
# Embedding 模型名称（用户自行配置，如 text-embedding-3-small 等）
EMBEDDING_MODEL_NAME=

# ===== 存储路径 =====
# FAISS 索引保存路径
FAISS_INDEX_PATH=./indexes
# 文档存储目录
DATA_DIR=./data

# ===== RAG 参数 =====
# 文档切分大小
CHUNK_SIZE=500
# 切分重叠大小
CHUNK_OVERLAP=50
# 检索返回文档数
RETRIEVAL_TOP_K=5

# ===== 对话记忆 =====
# 对话记忆窗口大小
CONVERSATION_WINDOW=5
